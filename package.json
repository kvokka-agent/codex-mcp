{
  "name": "@kvokka/codex-mcp",
  "version": "2.6.2",
  "description": "MCP server that wraps OpenAI Codex app-server \u2014 start coding agents, poll their progress, and manage permissions from any MCP client",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "codex-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun run scripts/build.mjs && bun run build:types",
    "build:types": "tsc --emitDeclarationOnly",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run build && bun test && bun run check:stdio && bun run smoke:mcp && bun run lint:md",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "prepublishOnly": "bun run build",
    "check:stdio": "bun scripts/check-stdio.mjs --timeout-ms 6000",
    "check:stdio:strict": "bun scripts/check-stdio.mjs --mode strict --timeout-ms 6000",
    "smoke:mcp": "bun scripts/mcp-smoke.mjs",
    "lint": "eslint src/ tests/",
    "lint:md": "rumdl check .",
    "lint:fallow": "fallow; code=$?; [ $code -le 1 ] && exit 0; exit $code",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "codex",
    "openai",
    "agent",
    "coding-agent",
    "model-context-protocol",
    "stdio",
    "json-rpc",
    "approval-workflow"
  ],
  "author": "kvokka",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvokka/codex-mcp.git"
  },
  "homepage": "https://github.com/kvokka/codex-mcp#readme",
  "bugs": {
    "url": "https://github.com/kvokka/codex-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.2",
    "fallow": "^3.20.0",
    "prettier": "^3.8.1",
    "rumdl": "0.2.60",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "yaml": "^2.8.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
