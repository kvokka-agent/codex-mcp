{
  "description": "Keeps the codex-mcp tools inside the codex subagent.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__(plugin_codex-mcp_)?codex-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/codex-subagent-only.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
