{
  // The per-file ceilings `bun scripts/fallow-gate.mjs` enforces over what
  // fallow measured. Every threshold fallow gates on itself — CRAP, cyclomatic
  // and cognitive complexity, unit size, duplication — lives in
  // `.fallowrc.jsonc` instead.
  "include": ["src/**/*.ts", "scripts/**/*.mjs", "plugins/**/*.mjs"],
  // Tests state what the code under them does; their size, their coupling and
  // their churn follow the code and say nothing on their own. The vendored
  // Codex JSON schemas are not hand-written.
  "exclude": ["tests/**", "codex-schema/**"],
  "churn": {
    "since": "6m",
    // Every file, not just one with three commits behind it: the combined
    // fallow run drops the rest, and a file added whole in one commit is
    // exactly the case the ceiling is for.
    "minCommits": 1
  },
  "ceilings": {
    "lines": 500,
    "fanOut": 15,
    "complexityDensity": 0.7,
    "churn": 1000
  },
  // Each entry names the file, the ceiling it stands over, the ceiling it is
  // held to instead, and why. An entry that no longer holds back a violation
  // fails the run, so the list stays as short as the code makes it.
  "exceptions": [
    {
      "path": "src/session/orphan-reaper.ts",
      "metric": "churn",
      "limit": 1300,
      "reason": "the file was written and reworked inside four days of the 3.0.0 orphan-reaping work — 1256 lines over seven commits on a 270-line file — so this is the writing of it rather than a file that keeps changing. It leaves the six-month window at the start of March 2027, and this entry fails the run once it does."
    }
  ]
}
