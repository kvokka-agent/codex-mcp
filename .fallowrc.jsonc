{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["scripts/*.mjs"],
  "dynamicallyLoaded": ["plugins/codex-mcp/hooks/*.mjs", "tests/helpers/fake-codex.mjs"],
  "ignorePatterns": ["codex-schema/**"],
  "includeEntryExports": true,
  "duplicates": {
    // 84 lines, 0.6% of lines today, in three groups: the two approval builders
    // of `src/session/manager.ts` that already delegate to
    // `awaitPendingRequest`, and the required and all-optional zod shapes of the
    // same session fields in `src/server.ts`. Each pair carries something its
    // twin does not — the shape of the MCP output schema, the decline path of a
    // live approval — so they stay, and this budget leaves ten lines before a
    // fourth group fails.
    "threshold": 0.7
  },
  "health": {
    "coverage": "coverage/coverage-final.json"
  }
}
